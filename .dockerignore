# =====================================================================
# Files excluded from the Docker build context.
#
# IMPORTANT: This file MUST live at the repo root, because Docker reads
# .dockerignore from the root of the build context. The Dockerfiles
# themselves live in docker/ and are referenced via:
#     docker build -f docker/Dockerfile.cpu -t nemasize:cpu .
# (the trailing "." is the build context = repo root).
#
# Note: Dockerfile.cpu / Dockerfile.gpu use explicit `COPY <file>` for
# the four pipeline scripts, so anything here is defense-in-depth AND
# keeps the build context small (faster `docker build`).
# =====================================================================

# --- Version control / IDE / OS ---------------------------------------
.git
.gitignore
.github
.vscode
.idea
*.swp
.DS_Store
Thumbs.db

# --- Python caches ----------------------------------------------------
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.mypy_cache
.ruff_cache
*.egg-info
.venv
venv
env

# --- Local data / runs (NEVER ship these) -----------------------------
runs/
datasets/
inference_rois/
NemaSize_output/
*.csv
*.log

# --- Docs ------------------------------------------------------------
*.md

# --- Sub-projects NOT used by run_pipeline.py -------------------------
name_lookup/
perform_test/
SLURM_scripts/

